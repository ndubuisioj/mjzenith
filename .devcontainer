{
  "name": "AI Tax Research Environment",
  "image": "://microsoft.com",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "github.copilot",
        "github.copilot-chat"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt"
}
